  "query": "SELECT h.hostname, s.id as \"site_id!\", s.name, r.id as \"release_id!\", r.sha\n               FROM site_hostnames h\n               JOIN sites s ON s.id = h.site_id\n               JOIN releases r ON r.id = s.current_release\n               WHERE s.status = 'active'",
