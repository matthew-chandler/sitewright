# systemd *user* unit for the dev VPS (devtest user, no root).
# Installed to ~/.config/systemd/user/sitewright.service by scripts/deploy-dev.sh.
[Unit]
Description=Sitewright (dev)
After=network-online.target

[Service]
# Configuration is read from %h/sitewright-data/config.toml (see deploy/dev-vps.toml).
ExecStart=%h/bin/sitewright serve --data-dir %h/sitewright-data
Environment=SITEWRIGHT_LOG_FORMAT=json
Restart=always
RestartSec=2
# Hardening that works without root in a user unit.
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=default.target
