# systemd *user* unit for the dev VPS (devtest user, no root).
# Installed to ~/.config/systemd/user/sitewright.service by scripts/deploy-dev.sh.
[Unit]
Description=Sitewright (dev)
After=network-online.target

[Service]
ExecStart=%h/bin/sitewright serve
Environment=SITEWRIGHT_LISTEN=127.0.0.1:18080
Environment=SITEWRIGHT_DATA_DIR=%h/sitewright-data
Environment=SITEWRIGHT_LOG_FORMAT=json
Restart=always
RestartSec=2
# Hardening that works without root in a user unit.
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=default.target
