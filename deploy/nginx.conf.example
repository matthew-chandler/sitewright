# nginx in front of Sitewright (proxy mode). Sitewright listens on 127.0.0.1:8080 and
# routes by the Host header, so one server block covers the admin UI and every site.
#
# In config.toml:
#   [server]
#   mode = "proxy"
#   listen = "127.0.0.1:8080"
#   trusted_proxies = ["127.0.0.1/32"]
#   [domains]
#   zones = ["example.com"]
#   public_scheme = "https"
#
# Certificates: a wildcard certificate for *.example.com (for example from certbot with a
# DNS plugin), or Cloudflare in front. Replace example.com throughout.

server {
    listen 80;
    listen [::]:80;
    server_name admin.example.com *.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name admin.example.com *.example.com;

    ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;

    # Site imports upload a whole site in one request.
    client_max_body_size 25m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        # Live agent progress is a server-sent event stream: do not buffer it, and let
        # long runs stay connected.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
